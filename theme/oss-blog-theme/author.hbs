{{!< default}}
{{#author}}
<header class="archive-header shell">
    <p class="eyebrow">AUTHOR</p>
    <h1>{{name}}</h1>
    {{#if bio}}<p>{{bio}}</p>{{/if}}
</header>
{{/author}}
<section class="section shell"><div class="post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>{{pagination}}</section>

