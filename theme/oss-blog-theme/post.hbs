{{!< default}}

{{#post}}
<article class="article shell-narrow {{post_class}}">
    <header class="article-header">
        <div class="article-kicker">
            {{#if primary_tag}}<a href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            <span>{{date published_at format="YYYY-MM-DD"}}</span>
            <span>{{reading_time minute="1 分钟阅读" minutes="% 分钟阅读"}}</span>
        </div>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-deck">{{custom_excerpt}}</p>{{/if}}
        <p class="byline">由 {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{/foreach}} 撰写</p>
    </header>
    {{#if feature_image}}
        <figure class="article-image">
            <img srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w" sizes="(max-width: 900px) 100vw, 900px" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}
    <div class="gh-content">{{content}}</div>
    {{#if tags}}<footer class="article-tags" aria-label="文章标签">{{tags prefix="标签：" separator=" · "}}</footer>{{/if}}
</article>

<section class="comments shell-narrow" aria-label="文章评论">
    {{comments title="参与讨论" count=true}}
</section>
{{/post}}

