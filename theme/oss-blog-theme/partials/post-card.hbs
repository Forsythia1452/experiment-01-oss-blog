<article class="post-card {{post_class}}">
    <a class="card-link" href="{{url}}" aria-label="阅读《{{title}}》">
        {{#if feature_image}}
            <img class="card-image" srcset="{{img_url feature_image size="s"}} 360w, {{img_url feature_image size="m"}} 720w" sizes="(max-width: 720px) 100vw, 33vw" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
        {{else}}
            <div class="card-image card-image-placeholder" aria-hidden="true"><span>{{@number}}</span></div>
        {{/if}}
        <div class="card-body">
            <div class="card-meta">
                {{#if primary_tag}}<span>{{primary_tag.name}}</span>{{else}}<span>未分类</span>{{/if}}
                <span>{{reading_time minute="1 分钟" minutes="% 分钟"}}</span>
            </div>
            <h3>{{title}}</h3>
            <p>{{excerpt words="28"}}</p>
            <span class="read-more">阅读文章 <span aria-hidden="true">→</span></span>
        </div>
    </a>
</article>

