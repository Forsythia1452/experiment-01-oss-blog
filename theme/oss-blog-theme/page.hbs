{{!< default}}
{{#post}}
<article class="article shell-narrow {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
        <header class="article-header"><p class="eyebrow">PAGE</p><h1>{{title}}</h1></header>
        {{#if feature_image}}
            <figure class="article-image"><img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"></figure>
        {{/if}}
    {{/if}}
    <div class="gh-content">{{content}}</div>
</article>
{{/post}}

